{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Telegram": {
    "AdminIds": [ 111111111 ],
    "Token": "<TELEGRAM_BOT_TOKEN_PLACEHOLDER>"
  },

  "WireGuardApi": {
    "ApiUrl": "http://<WIREGUARD_API_HOST:PORT>/"
  },

  "WireGuard": {
    "InterfaceName": "wg0",
    "ApplyWithSyncConf": true
  },

  "WireGuardDocker": {
    "Enabled": true,
    "Image": "ghcr.io/linuxserver/wireguard:latest",
    "DockerSocketPath": "/var/run/docker.sock",
    "HostWireGuardDir": "/etc/wireguard"
  },

  "ConnectionStrings": {
    "Default": "Data Source=/data/wireguard_bot.db"
  }
}