{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Telegram": {
    "AdminIds": [ 111111111 ],
    "Token": "<TELEGRAM_BOT_TOKEN_PLACEHOLDER>"
  },
  "WireGuardApi": {
    "ApiUrl": "http://<WIREGUARD_API_HOST:PORT>/"
  },
  "WireGuard": {
    "InterfaceName": "wg0",
    "ApplyWithSyncConf": true
  },
  "WireGuardDocker": {
    "Enabled": true,
    "DockerSocketPath": "/var/run/docker.sock",
    "TargetContainerName": "wg-easy"
  },
  "ConnectionStrings": {
    "Default": "Data Source=/data/wireguard_bot.db"
  }
}