# --- ASP.NET ---
ASPNETCORE_ENVIRONMENT=Production

# --- Telegram ---
Telegram__Token=<TELEGRAM_BOT_TOKEN_PLACEHOLDER>
# AdminIds можно перечислять так:
Telegram__AdminIds__0=<TELEGRAM_ADMIN_ID_PLACEHOLDER>
# Telegram__AdminIds__1=<TELEGRAM_ADMIN_ID_PLACEHOLDER_2>

# --- WireGuard API (wg-easy API или ваш сервис) ---
WireGuardApi__ApiUrl=http://<WIREGUARD_API_HOST:PORT>/
# если у вас используется пароль в API:
WireGuardApi__ApiPassword=<WIREGUARD_API_PASSWORD_PLACEHOLDER>

# --- WireGuard apply settings ---
WireGuard__InterfaceName=wg0
# true = мягко (syncconf) по умолчанию в ApplyConfigAsync
WireGuard__ApplyWithSyncConf=true

# --- Run wg/wg-quick inside existing wg-easy container via Docker socket ---
WireGuardDocker__Enabled=true
WireGuardDocker__DockerSocketPath=/var/run/docker.sock
# ВАЖНО: это container_name wg-easy (как он отображается в docker/portainer)
WireGuardDocker__TargetContainerName=wg-easy

# --- Database (SQLite in volume ./data -> /data) ---
# Подстройте ключ под вашу AddEfCoreConfiguration:
# если она читает ConnectionStrings:Sqlite (как в вашем appsettings.json) — используйте строку ниже:
ConnectionStrings__Sqlite=Data Source=/data/wireguard_bot.db